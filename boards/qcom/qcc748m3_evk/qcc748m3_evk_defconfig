CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y

# This board has 8 MiB of PSRAM; keep early startup in flash and run the
# remaining code and constants from PSRAM after initialization.
CONFIG_PSRAM=y
CONFIG_PSRAM_LENGTH=0x800000
CONFIG_PSRAM_COPY_CODE=y

# Use size optimization for every QCC748M board build.
CONFIG_SIZE_OPTIMIZATIONS=y

CONFIG_RESET=y

CONFIG_BT_LL_SW_SPLIT=n

# Preserve source SDK controller compatibility (HCI_Host_Buffer_Size unsupported).
CONFIG_BT_HCI_ACL_FLOW_CONTROL=n
