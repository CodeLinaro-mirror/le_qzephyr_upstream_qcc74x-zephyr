CONFIG_MAIN_STACK_SIZE=4096
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y

CONFIG_FLASH_SIZE=8

# Start bluetooth config
CONFIG_BT_LL_SW_SPLIT=n
CONFIG_BT_HCI_ACL_FLOW_CONTROL=n
# bluetooth debug log enable
#CONFIG_BT_HCI_DRIVER_LOG_LEVEL_DBG=y
# End bluetooth config

# Enable soc late initialization hook
CONFIG_SOC_LATE_INIT_HOOK=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_LOG=y
