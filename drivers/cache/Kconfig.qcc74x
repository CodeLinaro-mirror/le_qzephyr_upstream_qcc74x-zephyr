config CACHE_QCC74X
	bool "Qualcomm Opal L1 Cache Driver"
	default y
	depends on CACHE_MANAGEMENT
	select CACHE_HAS_DRIVER
	help
	  This option enables the CACHE driver for Opal MCUs.
