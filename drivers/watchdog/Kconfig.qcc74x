config WDT_QCC74X
	bool "Qualcomm Opal Watchdog (WDT) Driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_WATCHDOG_ENABLED
	depends on WATCHDOG
	select HAS_WDT_DISABLE_AT_BOOT
	help
	  Enable WDT driver for Opal MCUs.
