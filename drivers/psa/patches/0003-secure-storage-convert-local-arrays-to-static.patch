From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haoran Tian <haortian@qti.qualcomm.com>
Date: Wed Sep 23 02:00:00 2026 +0800
Subject: [PATCH] secure_storage: convert local arrays to static global

QCC74x has limited stack space. The ITS implementation uses large
local arrays (e.g. uint8_t data[MAX_DATA_SIZE]) that can cause stack
overflow. This patch converts them to static global variables,
matching the QCC730 fix in 0009_secure_storage_convert_local_arrays_to_static.patch.

Signed-off-by: Haoran Tian <haortian@qti.qualcomm.com>
---
 subsys/secure_storage/src/its/implementation.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/subsys/secure_storage/src/its/implementation.c b/subsys/secure_storage/src/its/implementation.c
index afa24c5cd80..b466108752b 100644
--- a/subsys/secure_storage/src/its/implementation.c
+++ b/subsys/secure_storage/src/its/implementation.c
@@ -11,6 +11,14 @@
 
 LOG_MODULE_DECLARE(secure_storage, CONFIG_SECURE_STORAGE_LOG_LEVEL);
 
+/*
+ * Global buffers shared by all ITS operations.
+ * Using static globals instead of stack-local arrays to avoid stack overflow
+ * on resource-constrained MCUs (QCC74x, QCC73x).
+ */
+static uint8_t data[CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE];
+static uint8_t stored_data[SECURE_STORAGE_ITS_TRANSFORM_MAX_STORED_DATA_SIZE];
+
 #ifndef CONFIG_SECURE_STORAGE_64_BIT_UID
 BUILD_ASSERT(sizeof(secure_storage_its_uid_t) == 4); /* ITS UIDs are 32-bit */
 BUILD_ASSERT(1 << SECURE_STORAGE_ITS_CALLER_ID_BIT_SIZE >= SECURE_STORAGE_ITS_CALLER_COUNT);
@@ -81,7 +89,6 @@ static psa_status_t get_entry(secure_storage_its_uid_t uid, size_t data_size, ui
 			      size_t *data_len, psa_storage_create_flags_t *create_flags)
 {
 	psa_status_t ret;
-	uint8_t stored_data[SECURE_STORAGE_ITS_TRANSFORM_MAX_STORED_DATA_SIZE];
 	size_t stored_data_len;
 
 	ret = get_stored_data(uid, stored_data, &stored_data_len);
@@ -97,10 +104,10 @@ static bool keep_stored_entry(secure_storage_its_uid_t uid, size_t data_length,
 			      psa_storage_create_flags_t create_flags, psa_status_t *ret)
 {
 	psa_storage_create_flags_t existing_create_flags;
-	uint8_t existing_data[CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE];
+	uint8_t *existing_data = data;
 	size_t existing_data_len;
 
-	*ret = get_entry(uid, sizeof(existing_data), existing_data, &existing_data_len,
+	*ret = get_entry(uid, sizeof(data), existing_data, &existing_data_len,
 			 &existing_create_flags);
 	if (*ret != PSA_SUCCESS) {
 		/* The entry either doesn't exist or is corrupted. */
@@ -133,7 +140,6 @@ static psa_status_t store_entry(secure_storage_its_uid_t uid, size_t data_length
 				const void *p_data, psa_storage_create_flags_t create_flags)
 {
 	psa_status_t ret;
-	uint8_t stored_data[SECURE_STORAGE_ITS_TRANSFORM_MAX_STORED_DATA_SIZE];
 	size_t stored_data_len;
 
 	ret = secure_storage_its_transform_to_store(uid, data_length, p_data, create_flags,
@@ -182,7 +188,6 @@ psa_status_t secure_storage_its_get(secure_storage_its_caller_id_t caller_id, ps
 {
 	psa_status_t ret;
 	secure_storage_its_uid_t its_uid;
-	uint8_t stored_data[SECURE_STORAGE_ITS_TRANSFORM_MAX_STORED_DATA_SIZE];
 	size_t stored_data_len;
 	psa_storage_create_flags_t create_flags;
 
@@ -204,7 +209,6 @@ psa_status_t secure_storage_its_get(secure_storage_its_caller_id_t caller_id, ps
 		return transform_stored_data(its_uid, stored_data_len, stored_data, data_size,
 					     p_data, p_data_length, &create_flags);
 	}
-	uint8_t data[CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE];
 	size_t data_len;
 
 	ret = transform_stored_data(its_uid, stored_data_len, stored_data, sizeof(data), data,
@@ -226,7 +230,6 @@ psa_status_t secure_storage_its_get_info(secure_storage_its_caller_id_t caller_i
 {
 	psa_status_t ret;
 	secure_storage_its_uid_t its_uid;
-	uint8_t data[CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE];
 
 	if (make_its_uid(caller_id, uid, &its_uid) != PSA_SUCCESS) {
 		return PSA_ERROR_INVALID_ARGUMENT;
@@ -245,7 +248,6 @@ psa_status_t secure_storage_its_remove(secure_storage_its_caller_id_t caller_id,
 	psa_status_t ret;
 	secure_storage_its_uid_t its_uid;
 	psa_storage_create_flags_t create_flags;
-	uint8_t data[CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE];
 	size_t data_len;
 
 	if (make_its_uid(caller_id, uid, &its_uid) != PSA_SUCCESS) {
