config GPIO_QCC74X
	bool "Qualcomm Opal GPIO driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_GPIO_ENABLED
	depends on GPIO
	help
	  Enable GPIO driver for Opal MCUs.
