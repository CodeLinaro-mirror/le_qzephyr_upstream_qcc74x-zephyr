config BT_QCC74X
	bool "Qualcomm Opal BT_HCI driver"
	default y
	depends on BT
	depends on DT_HAS_QCOM_QCC74X_BT_HCI_ENABLED
	help
	  Enables BT_HCI bluetooth driver for Opal MCUs.

if BT_QCC74X

config BT_BUF_ACL_RX_SIZE
		int
		default 251

config HEAP_MEM_POOL_SIZE
	int "Heap Memory Pool Size"
	default 8192
	help
	  Specifies the size of the heap memory pool in bytes.

endif