config UDC_QCC74X
	bool "Qualcomm Opal USB device controller driver"
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT
	imply UDC_WORKQUEUE
	default y
	depends on DT_HAS_QCOM_QCC74X_UDC_ENABLED
	help
	  Enable USB driver for Opal MCUs.

if UDC_QCC74X

config UDC_QCC74X_EVENT_COUNT
	int "Number or blocks in event slab"
	range 8 32
	default 16
	help
	  Number of blocks in slab for internal endpoint events.

endif # UDC_QCC74X
