menuconfig ETH_QCC74X_EMAC
	bool "Qualcomm Opal Ethernet driver for emac"
	default y
	depends on DT_HAS_QCOM_QCC74X_EMAC_ENABLED
	select MDIO
	select PINCTRL
	select GPIO
	help
	  Enable Ethernet driver for Opal MCUs.

if ETH_QCC74X_EMAC

config ETH_QCC74X_EMAC_RX_THREAD_STACK_SIZE
	int "Opal Ethernet receive thread stack size"
	default 768

config ETH_QCC74X_EMAC_RX_THREAD_PRIORITY
	int "Opal Ethernet receive thread priority"
	default 2

config ETH_QCC74X_EMAC_TX_BUFF_CNT
	int "Opal Ethernet TX Buffer Count"
	default 6

config ETH_QCC74X_EMAC_RX_BUFF_CNT
	int "Opal Ethernet RX Buffer Count"
	default 10

endif # ETH_QCC74X_EMAC
