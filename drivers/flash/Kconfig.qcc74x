config SOC_FLASH_QCC74X
	bool "Qualcomm Opal flash driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_FLASH_CONTROLLER_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_EXPLICIT_ERASE
	help
	  Enable flash driver for Opal MCUs.
