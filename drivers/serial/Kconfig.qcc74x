config UART_QCC74X
	bool "Qualcomm Opal UART driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_UART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC
	select PINCTRL
	help
		Enable UART driver for Opal MCUs.
		This driver supports polling, interrupt-driven, and asynchronous API.

if UART_QCC74X

config UART_QCC74X_ASYNC_TO_IRQ
	bool
	default y if UART_ASYNC_API
	select UART_INTERRUPT_DRIVEN
	help
	  Enforce interrupt-driven API when async is enabled.
	  The async implementation relies on RX timeout interrupts (RTO)
	  and DMA callbacks, so interrupt support is mandatory.

endif # UART_QCC74X
