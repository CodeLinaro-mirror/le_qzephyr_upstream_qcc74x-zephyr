config PWM_QCC74X
	bool "Qualcomm Opal PWM driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_PWM_ENABLED
	depends on PWM
	select PINCTRL
	select PM_DEVICE if PM
	help
	  Enable PWM driver for Opal MCUs.