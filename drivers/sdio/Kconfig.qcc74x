menuconfig SDIO
	bool "SDIO peripheral driver"
	help
	  This option enables the SDIO custom driver class for Opal MCUs.

if SDIO

config SDIO_INIT_PRIORITY
	int "SDIO peripheral drivers init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  SDIO peripheral drivers init priority.

module = SDIO
module-str = sdio
source "subsys/logging/Kconfig.template.log_config"

config SDIO_QCC74X
	bool "Qualcomm Opal SDIO driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_SDIO_ENABLED
	select PINCTRL
	select GPIO
	help
	  Enables SDIO peripheral interface driver for Opal MCUs.

endif # SDIO
