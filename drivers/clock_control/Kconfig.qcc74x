config CLOCK_CONTROL_QCC74X
	bool "Qualcomm Opal Clock Control Driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_CLOCK_CONTROLLER_ENABLED
	help
	  This option enables the CLOCK CONTROL driver for Opal MCUs.
