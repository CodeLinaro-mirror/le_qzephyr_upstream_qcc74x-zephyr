config VIDEO_QCC74X
	bool "Qualcomm Opal family Video driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_CAM_ENABLED
	select PINCTRL
	select GPIO	
	help
	  Enable video driver for Opal MCUs.
