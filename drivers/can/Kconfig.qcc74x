config CAN_QCC74X
	bool "Qualcomm Opal CAN Driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_CAN_ENABLED
	select PINCTRL
	help
	  This option enables the CAN driver for Opal MCUs.

if CAN_QCC74X

config CAN_MAX_FILTER
	int "Maximum number of concurrent active filters"
	default 4
	range 1 32
	help
	  Maximum number of filters supported by the can_add_rx_callback() API call.

endif # CAN_QCC74X