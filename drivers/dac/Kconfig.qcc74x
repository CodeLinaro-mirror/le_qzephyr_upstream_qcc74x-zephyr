config DAC_QCC74X
	bool "Qualcomm Opal DAC driver"
	default y
	depends on DAC
	depends on DT_HAS_QCOM_QCC74X_DAC_ENABLED
	select PINCTRL
	help
	  Enable DAC driver for Opal MCUs.

if DAC_QCC74X

config DAC_QCC74X_DMA
	bool "Opal DAC DMA support"
	default y
	depends on DT_HAS_QCOM_QCC74X_DMA_ENABLED
	select DMA
	help
	  Select DAC DMA mode for DAC data source.

endif # DAC_QCC74X
