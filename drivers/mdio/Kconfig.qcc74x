config MDIO_QCC74X
	bool "Qualcomm Opal MDIO driver"
	default y
	depends on DT_HAS_QCOM_QCC74X_MDIO_ENABLED
	select PINCTRL
	help
	  Enable MDIO driver for Opal MCUs.
