config ENTROPY_RNG_QCC74X
	bool "Qualcomm Opal entropy number generator driver"
	default y
	depends on ENTROPY_GENERATOR
	depends on DT_HAS_QCOM_QCC74X_TRNG_ENABLED
	select ENTROPY_HAS_DRIVER
	help
	  This option enables the entropy number generator for Opal MCUs.
