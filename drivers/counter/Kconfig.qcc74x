config COUNTER_TMR_QCC74X
	bool "Qualcomm Opal Counter Driver based on GP-Timers"
	default y
	depends on DT_HAS_QCOM_QCC74X_TIMER_ENABLED
	depends on COUNTER
	help
	  Enables the Counter driver API based on General
	  Purpose Timers for Opal MCUs.
