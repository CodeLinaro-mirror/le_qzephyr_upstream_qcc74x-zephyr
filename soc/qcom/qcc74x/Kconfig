config SOC_SERIES_QCC74X
	select RISCV
	select RISCV_PRIVILEGED
	select RISCV_HAS_CLIC
	select RISCV_SOC_CONTEXT_SAVE if !QCC74X_WIFI_PERF_MODE
	select INCLUDE_RESET_VECTOR
	select RISCV_SOC_HAS_GP_RELATIVE_ADDRESSING
	select DYNAMIC_INTERRUPTS
	select SHARED_INTERRUPTS
	select SOC_LATE_INIT_HOOK
	select CLOCK_CONTROL
	select ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select NOCACHE_MEMORY

	select RISCV_ISA_RV32I
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select HAS_QCOM_QCC74X_HAL
	select CPU_HAS_FPU
	select CPU_HAS_DCACHE
	select CPU_HAS_ICACHE
	select RISCV_PMP
	select FPU
	select MULTI_HEAP
	select SYS_HEAP_RUNTIME_STATS
	select HAS_PM
	select HAS_POWEROFF
	select SOC_EARLY_INIT_HOOK if POWEROFF

if SOC_SERIES_QCC74X

config QCC74X_COREDUMP_FULL_MEMORY
	bool "Dump QCC74x physical RAM and tracked PSRAM allocations"
	depends on DEBUG_COREDUMP_MEMORY_DUMP_LINKER_RAM
	depends on PSRAM && PSRAM_LENGTH > 0
	default n
	help
	  Replace Zephyr's default linker-RAM coredump list with QCC74x OCRAM,
	  Wi-Fi WRAM, HBN RAM, static PSRAM, and active PSRAM allocations tracked
	  by the SoC multi-heap allocator. This is an opt-in diagnostic profile.

config QCC74X_COREDUMP_PSRAM_LEDGER_MAX_ENTRIES
	int "Maximum tracked PSRAM allocations in a coredump"
	depends on QCC74X_COREDUMP_FULL_MEMORY
	range 1 256
	default 64
	help
	  Fixed number of active PSRAM allocation records retained by the SoC
	  allocator. An overflow marker is retained if PSRAM coverage is incomplete.

choice QCC74X_COREDUMP_SERIAL_PSRAM_MODE
	prompt "QCC74x serial coredump PSRAM coverage"
	depends on QCC74X_COREDUMP_FULL_MEMORY
	depends on DEBUG_COREDUMP_MEMORY_DUMP_LINKER_RAM
	depends on DEBUG_COREDUMP_BACKEND_LOGGING || DEBUG_COREDUMP_BACKEND_OTHER
	depends on PSRAM && PSRAM_LENGTH > 0
	default QCC74X_COREDUMP_SERIAL_FULL_PSRAM
	help
	  Select the PSRAM coverage used by the QCC74x serial coredump profiles.
	  Both the standard logging backend and the QCC74x custom safe-serial
	  backend use this choice. Flash coredump retains its tracked-PSRAM policy.

config QCC74X_COREDUMP_SERIAL_FULL_PSRAM
	bool "Dump the complete physical PSRAM window"
	help
	  Emit the full DTS PSRAM range to the selected serial coredump backend.
	  This is a diagnostic profile and can expose allocated, free, and stale
	  data.

config QCC74X_COREDUMP_SERIAL_TRACKED_PSRAM
	bool "Dump static and tracked active PSRAM"
	help
	  Emit the linker-placed static PSRAM prefix plus active allocations
	  recorded by the QCC74x SoC multi-heap ledger.

endchoice

config QCC74X_HBN_SHELL
	bool "Enable QCC74X HBN shell command"
	depends on POWEROFF && SHELL
	default n
	help
	  Enable the QCC74X-specific HBN shell command. The command uses the
	  Zephyr system-off API and is available to any shell-enabled
	  application built for QCC74X; it is not tied to a particular sample.

	  The command provides HBN wake information query and clear operations.
	  QCC74X Zephyr HBN always uses HBN0 and supports RTC or ACOMP edge wake.

config ANTI_ROLLBACK
	bool "Enable QCC74X application anti-rollback support"
	default n
	help
	  Embed an application anti-rollback version in the image and provide
	  APIs to read and advance the corresponding eFuse value. The eFuse is
	  irreversible: call qcc74x_anti_rollback_version_commit() only after a
	  new image has completed its product-specific health checks.

config APP_ANTI_ROLLBACK_VER
	int "QCC74X application anti-rollback version"
	depends on ANTI_ROLLBACK
	default 0
	range 0 128
	help
	  Version embedded in the firmware image. Version zero is an
	  unprovisioned image version and cannot be committed to eFuse. Use a
	  monotonically increasing value in the range 1 through 128 for a
	  production image that will be committed.

config QCC74X_WIFI_PERF_MODE
	bool "WiFi high-performance mode (disables ECLIC interrupt-level context save)"
	default n
	help
	  Enable in WiFi-throughput builds only. Without this option,
	  RISCV_SOC_CONTEXT_SAVE is selected, which adds two function calls
	  (__soc_save_context / __soc_restore_context) to every trap entry/exit.

config QCC74X_PM_DIAGNOSTICS
	bool "Enable QCC74X PM diagnostics"
	depends on PM
	default n
	help
	  Enable lightweight System PM diagnostics for the QCC74X shallow
	  suspend-to-idle path and the PDS15 suspend-to-ram flow. This is
	  intended for bring-up and validation of QCC74X PM behavior.

config LPAPP
	bool
	help
	  Internal SDK compatibility switch used by the QCC74X linker script
	  and HAL low-power code for LPFW/PDS15 layout.

config QCC74X_PM_PDS15
	bool "Enable QCC74X PDS15 suspend-to-ram path"
	depends on PM && !PSRAM && !RISCV_MACHINE_TIMER
	select LPAPP
	default n
	help
	  Enable the QCC74X adapter that maps PM_STATE_SUSPEND_TO_RAM to
	  the vendor LPFW + PDS15 flow with RTC one-shot wakeup.

	  The current low-power path does not support PSRAM-enabled images.
	  It also uses a QCC74X-local system timer so the generic RISC-V
	  machine timer driver remains unmodified.

config QCC74X_PM_PDS15_SYSTEM_TIMER
	bool "Use QCC74X PDS15-aware system timer"
	depends on QCC74X_PM_PDS15 && !RISCV_MACHINE_TIMER
	default y
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	help
	  Use a QCC74X-local RISC-V machine timer implementation that can
	  rebase Zephyr kernel ticks after PDS15 without patching the generic
	  RISC-V timer driver.

config QCC74X_PM_PDS15_DEBUG_LOG
	bool "Enable verbose QCC74X PDS15 bring-up logs"
	depends on QCC74X_PM_PDS15 && QCC74X_PM_DIAGNOSTICS
	default n
	help
	  Enable detailed PDS15/LPFW/Wi-Fi resume logging diagnostics used
	  during bring-up and bench validation. Production builds should keep
	  this disabled so the SoC PM path stays quiet by default.

module = QCC74X_PM_PDS15
module-str = QCC74X PDS15 PM
source "subsys/logging/Kconfig.template.log_config"

config QCC74X_PM_PDS15_AUTO_INIT
	bool "Automatically initialize QCC74X PDS15 LPFW at boot"
	depends on QCC74X_PM_PDS15
	default y
	help
	  Initialize the vendor LPFW/PDS15 handoff during Zephyr application
	  init so the automatic low-power policy can be enabled without a
	  separate LPFW shell initialization step.

config QCC74X_PM_PDS15_POLICY
	bool "Use the QCC74X automatic PDS15 PM policy"
	depends on QCC74X_PM_PDS15 && PM_POLICY_CUSTOM
	default n
	help
	  Use a QCC74X-specific Zephyr PM policy that preserves the default
	  residency, device-busy, and policy-lock behavior, but only selects
	  PDS15 when the QCC74X automatic low-power gate and diagnostics say
	  that suspend-to-ram substate 15 is currently allowed.

config QCC74X_PM_PDS15_UART_RESUME
	bool "Reinitialize the Zephyr console UART after PDS15 resume"
	depends on QCC74X_PM_PDS15 && SERIAL
	default y
	help
	  Reapply the console UART hardware configuration after returning from
	  PDS15 so shell-based validation remains observable.

config QCC74X_PM_PDS15_BLE
	bool "Enable QCC74X PDS15 BLE controller low power"
	depends on QCC74X_PM_PDS15 && BT
	default n
	help
	  Integrate the BLE controller sleep API (btble_controller_sleep /
	  btble_controller_sleep_restore) into the PDS15 flow.

	  When enabled:
	  - PDS15 entry queries the BLE controller for its desired sleep
	    duration and takes the minimum of BLE/WiFi/RTOS timeouts.
	  - BLE activity (btble_controller_sleep() < 0) blocks PDS15 entry
	    and falls back to WFI.
	  - The BLE controller is restored via btble_controller_sleep_restore()
	    in the PDS15 wake path.
	  - A BLE crash guard detects overslept wake cycles and performs a
	    GLB soft reset of the BTDM domain.

config QCC74X_PM_PDS15_BLE_CRASH_TOLERANCE_US
	int "BLE crash detection tolerance (microseconds)"
	depends on QCC74X_PM_PDS15_BLE
	default 50000
	help
	  Allow elapsed_us to exceed the BLE-requested wake time by up to
	  this many microseconds before triggering BLE crash recovery
	  (GLB BTDM soft reset). Reduce for stricter testing, increase for
	  noisy hardware environments.

endif # SOC_SERIES_QCC74X
