if SOC_SERIES_QCC74X

DT_PSRAM_COMPAT := qc7xx-psram

config KERNEL_ENTRY
	default "__qc7xx_start"

config NUM_IRQS
	default 80

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/soc/timer@e000bff8,clock-frequency)

config SOC_ENABLE_XIP
	bool "Enable XIP for this SoC"
	default y
	select XIP
	help
	  Enable Execute In Place (XIP) for this SoC.

config RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config BOARD_FLASH_INIT_SKIP
	bool "Skip flash init for this SoC"
	default n
	help
	  Skip flash init for this SoC.

config BOARD_FLASH_LOW_SPEED
	bool "Enable Flash low speed for this SoC"
	default n
	help
	  Enable Flash low speed for this SoC.

config FLASH_XIP_LENGTH
	hex "Flash xip length"
	default 0x400000
	help
	  Length of the flash XIP region. Referenced by soc/qcom/qcc74x/common.ld
	  as the length of the rom memory region.

config PSRAM_LENGTH
	hex "PSRAM length"
	default 0
	help
	  Total PSRAM size in bytes (0 = disabled, 4 MB = 0x400000,
	  8 MB = 0x800000). Referenced by soc/qcom/qcc74x/common.ld as the
	  length of the ram_psram memory region when CONFIG_PSRAM is enabled.

config PSRAM_COPY_CODE
	bool "Enable psram copy code for this SoC"
	default n
	help
	  Enable the psram copy-code linker path in soc/qcom/qcc74x/common.ld,
	  which relocates selected code/data sections from flash to PSRAM at
	  boot for faster execution.

config PSRAM
	bool "Enable psram for this SoC"
	default y if $(dt_compat_enabled,$(DT_PSRAM_COMPAT))
	help
	  Enable application PSRAM support if a device-tree node with
	  compatible vendor,psram is present and enabled.

config COMMON_LIBC_MALLOC_ARENA_SIZE
        default 4096 if COMMON_LIBC_MALLOC

config PMP_SLOTS
	int "Number of PMP slots"
	default 16
	help
	  This is the number of PMP entries implemented by the hardware.
	  Typical values are 8 or 16.

config PMP_NO_NA4
	bool
	default y
	help
	  Set this if NA4 (Naturally Aligned 4-byte) mode is not supported.

config PMP_GRANULARITY
	default 128

config XTAL_POWER_TYPE_ACTIVE
	bool
	default n
	help
	  Get xtal power type

config MAIN_STACK_SIZE
	default 4096

config CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

endif # SOC_SERIES_QCC74X
