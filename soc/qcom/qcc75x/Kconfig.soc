config SOC_SERIES_QCC75X
	bool
	select SOC_FAMILY_QCOM_QCC7XX

config SOC_QCC75X
	bool
	select SOC_SERIES_QCC75X

config GEN_SW_ISR_TABLE
	bool

config SOC
	default "qcc75x" if SOC_QCC75X

config SOC_SERIES
	default "qcc75x" if SOC_SERIES_QCC75X
